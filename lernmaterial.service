[Unit]
Description=Lernmaterial static site (password protected)
After=network.target

[Service]
User=exedev
WorkingDirectory=/home/exedev/lernmaterial
EnvironmentFile=/etc/lernmaterial/env
ExecStart=/home/exedev/lernmaterial/bin/serve -addr :8000 -dir /home/exedev/lernmaterial/output
Restart=always

[Install]
WantedBy=multi-user.target
