[Unit]
Description=Learning material site (account protected)
After=network.target

[Service]
User=exedev
WorkingDirectory=/home/exedev/learningmaterial
EnvironmentFile=/etc/learningmaterial/env
ExecStart=/home/exedev/learningmaterial/bin/serve -addr :8000 \
  -dir /home/exedev/learningmaterial/output \
  -repo /home/exedev/learningmaterial \
  -users /users \
  -db /home/exedev/learningmaterial/data/requests.db \
  -work /home/exedev/learningmaterial/data/worktrees \
  -preview /home/exedev/learningmaterial/data/preview \
  -sandboxes /home/exedev/learningmaterial/data/sandboxes
Restart=always

[Install]
WantedBy=multi-user.target
